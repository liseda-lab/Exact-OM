{
  "contract": "exact-description/2",
  "examples": [
    {
      "claims": [
        {
          "category": "meaning",
          "claim_id": "sha256:b77b69c9ee8a2a53316ab4f7694d1985305fc5527f41ae0ed0502e4be65b8a99",
          "fact_ids": [
            "sha256:6557823785ffa80e0c5ed1cd9e8cf56e097615bd98b9ca7525168f35faf92a95",
            "sha256:2b61ea6891b3701da000dd20b5cc1bf12315523f0bad39f8e6d8849387ef0a11"
          ],
          "text": "Fontaine progeroid syndrome is a progeroid syndrome characterized by poor growth, abnormal skeletal features, distinctive craniofacial features, sagging thin skin, and decreased subcutaneous fat suggesting an aged appearance that is most pronounced in infancy and improves over time; it has a material basis in a heterozygous mutation in SLC25A24 on chromosome 1p36."
        }
      ],
