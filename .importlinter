[importlinter]
root_package = exact
include_external_packages = True

[importlinter:contract:core-boundary]
name = Core does not depend on implementation or outer layers
type = forbidden
source_modules =
    exact.core
forbidden_modules =
    exact.impl
    exact.delivery
    exact.analysis
    exact.ontology
    exact.io
ignore_imports =
    exact.core.actions.alignment -> exact.impl
    exact.core.actions.alignment -> exact.impl.seed

[importlinter:contract:ontology-boundary]
name = Ontology does not depend on implementation or delivery
type = forbidden
source_modules =
    exact.ontology
    exact.io.**
forbidden_modules =
    exact.impl
    exact.delivery

[importlinter:contract:implementation-boundary]
name = Implementation does not depend on analysis or delivery
type = forbidden
source_modules =
    exact.impl
forbidden_modules =
    exact.analysis
    exact.delivery

[importlinter:contract:no-delivery-imports]
name = Library and analysis subsystems do not depend on delivery
type = forbidden
source_modules =
    exact.**
forbidden_modules =
    exact.delivery

[importlinter:contract:pyhornedowl-boundary]
name = pyhornedowl is isolated in the ontology parser
type = forbidden
source_modules =
    exact
forbidden_modules =
    pyhornedowl
ignore_imports =
    exact.ontology.parser -> pyhornedowl

[importlinter:contract:rdflib-boundary]
name = rdflib is isolated in IO sources
type = forbidden
source_modules =
    exact
forbidden_modules =
    rdflib
# WP-B retains an rdflib parser fallback until WP-G moves RDF dispatch into exact.io.
ignore_imports =
    exact.ontology.parser -> rdflib
    exact.io.** -> rdflib
unmatched_ignore_imports_alerting = none
