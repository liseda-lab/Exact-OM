[importlinter]
root_package = exact
include_external_packages = True

[importlinter:contract:core-boundary]
name = Core does not depend on implementation or outer layers
type = forbidden
source_modules =
    exact.core
forbidden_modules =
    exact.impl
    exact.delivery
    exact.analysis
    exact.ontology
    exact.io

[importlinter:contract:ontology-boundary]
name = Ontology does not depend on implementation or delivery
type = forbidden
source_modules =
    exact.ontology
    exact.io.**
forbidden_modules =
    exact.impl
    exact.delivery

[importlinter:contract:implementation-boundary]
name = Implementation does not depend on analysis or delivery
type = forbidden
source_modules =
    exact.impl
forbidden_modules =
    exact.analysis
    exact.delivery

[importlinter:contract:no-delivery-imports]
name = Library and analysis subsystems do not depend on delivery
type = forbidden
source_modules =
    exact.**
forbidden_modules =
    exact.delivery

[importlinter:contract:rdflib-boundary]
name = rdflib is isolated in IO sources
type = forbidden
source_modules =
    exact
forbidden_modules =
    rdflib
ignore_imports =
    exact.io.** -> rdflib
unmatched_ignore_imports_alerting = none
