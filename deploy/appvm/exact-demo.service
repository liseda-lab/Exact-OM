[Unit]
Description=Exact Explain fixed reviewer demo
After=network.target

[Service]
Type=simple
User=pcotovio
WorkingDirectory=/home/pcotovio/exact-demo/release
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=EXACT_DEMO_PACKAGE=/home/pcotovio/exact-study/assets/reviewer-demo-20261117-package.json
Environment=EXACT_DEMO_FRONTEND=/home/pcotovio/exact-demo/release/explanations_visualizer/out
ExecStart=/home/pcotovio/Exact-OM/.venv/bin/python -m uvicorn deploy.appvm.demo_server:app --factory --host 127.0.0.1 --port 8010 --limit-concurrency 24 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
MemoryMax=2G
CPUQuota=100%
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
InaccessiblePaths=/home/pcotovio/exact-study/study.env /home/pcotovio/exact-study/production-20261114/private /home/pcotovio/exact-study/descriptions-20261114/private
UMask=0077

[Install]
WantedBy=multi-user.target
