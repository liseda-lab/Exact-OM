# IT terminates HTTPS. This replaces only the existing named port-80 vhost.
server {
    listen 80;
    server_name exact-explain.lasige.di.fc.ul.pt;
    access_log off;
    client_max_body_size 10m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header Connection "";
    proxy_read_timeout 300s;
    proxy_cache off;
    proxy_buffering off;

    # Study traffic retains its exact upstream; no study restart or DB mutation.
    location /api/v1/study { proxy_pass http://127.0.0.1:8000; }
    location /api/v1/admin { proxy_pass http://127.0.0.1:8000; }
    location / { proxy_pass http://127.0.0.1:8000; }

    location = / { proxy_pass http://127.0.0.1:8010; }
    location = /browse { proxy_pass http://127.0.0.1:8010; }
    location = /browse/ { proxy_pass http://127.0.0.1:8010; }
    location /api/v1/ {
        limit_req zone=exact_demo burst=200 nodelay;
        limit_req_status 429;
        client_max_body_size 64k;
        proxy_pass http://127.0.0.1:8010;
    }
    # Existing study assets always use their unchanged upstream first.
    # Only unknown build hashes fall back to the new demo's asset registry.
    location /_next/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_intercept_errors on;
        error_page 404 = @demo_assets;
    }
    location @demo_assets { proxy_pass http://127.0.0.1:8010; }
}
