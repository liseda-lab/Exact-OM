<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/mini/src#"
     xml:base="http://example.org/mini/src"
     xmlns:align="http://oaei.ontologymatching.org/bio-ml/ann/"
     xmlns:ex="http://example.org/mini/src#"
     xmlns:iao="http://purl.obolibrary.org/obo/"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

  <owl:Ontology rdf:about="http://example.org/mini/src"/>

  <owl:AnnotationProperty rdf:about="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
  <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:AnnotationProperty rdf:about="http://oaei.ontologymatching.org/bio-ml/ann/use_in_alignment"/>

  <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000050">
    <rdfs:label>part of</rdfs:label>
    <rdfs:domain rdf:resource="#AnatomicalEntity"/>
    <rdfs:range rdf:resource="#AnatomicalEntity"/>
    <owl:inverseOf rdf:resource="#hasPart"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#hasPart">
    <rdfs:label>has part</rdfs:label>
    <rdfs:domain rdf:resource="#AnatomicalEntity"/>
    <rdfs:range rdf:resource="#AnatomicalEntity"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#relatedTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:label>related to</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#participatesIn">
    <rdfs:label>participates in</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="#relatedTo"/>
    <rdfs:domain rdf:resource="#Person"/>
    <rdfs:range rdf:resource="#Study"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="#hasCode">
    <rdfs:label>has code</rdfs:label>
    <rdfs:domain rdf:resource="#Entity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:Class rdf:about="#Entity"><rdfs:label>entity</rdfs:label></owl:Class>
  <owl:Class rdf:about="#Organism"><rdfs:subClassOf rdf:resource="#Entity"/><rdfs:label>organism</rdfs:label></owl:Class>
  <owl:Class rdf:about="#AnatomicalEntity"><rdfs:subClassOf rdf:resource="#Entity"/><rdfs:label>anatomical entity</rdfs:label></owl:Class>
  <owl:Class rdf:about="#Structure"><rdfs:subClassOf rdf:resource="#AnatomicalEntity"/><rdfs:label>structure</rdfs:label></owl:Class>
  <owl:Class rdf:about="#Cell"><rdfs:subClassOf rdf:resource="#AnatomicalEntity"/><rdfs:label>cell</rdfs:label></owl:Class>
  <owl:Class rdf:about="#Tissue"><rdfs:subClassOf rdf:resource="#Structure"/><rdfs:label>tissue</rdfs:label></owl:Class>
  <owl:Class rdf:about="#Organ"><rdfs:subClassOf rdf:resource="#Structure"/><rdfs:label>organ</rdfs:label></owl:Class>
  <owl:Class rdf:about="#Heart">
    <rdfs:subClassOf rdf:resource="#Organ"/>
    <rdfs:subClassOf rdf:resource="#CardiacStructure"/>
    <rdfs:label xml:lang="en">heart</rdfs:label>
    <rdfs:label xml:lang="pt">coração</rdfs:label>
    <oboInOwl:hasExactSynonym>cardiac organ</oboInOwl:hasExactSynonym>
    <iao:IAO_0000115>The muscular organ that pumps blood.</iao:IAO_0000115>
  </owl:Class>
  <owl:Class rdf:about="#Lung"><rdfs:subClassOf rdf:resource="#Organ"/><rdfs:label>lung</rdfs:label></owl:Class>
  <owl:Class rdf:about="#Kidney"><rdfs:subClassOf rdf:resource="#Organ"/><rdfs:label>kidney</rdfs:label></owl:Class>
  <owl:Class rdf:about="#BloodVessel"><rdfs:subClassOf rdf:resource="#Structure"/><rdfs:label>blood vessel</rdfs:label></owl:Class>
  <owl:Class rdf:about="#Artery"><rdfs:subClassOf rdf:resource="#BloodVessel"/><rdfs:label>artery</rdfs:label></owl:Class>
  <owl:Class rdf:about="#Vein"><rdfs:subClassOf rdf:resource="#BloodVessel"/><rdfs:label>vein</rdfs:label></owl:Class>
  <owl:Class rdf:about="#Disease"><rdfs:subClassOf rdf:resource="#Entity"/><rdfs:label>disease</rdfs:label></owl:Class>
  <owl:Class rdf:about="#CardiacDisease"><rdfs:subClassOf rdf:resource="#Disease"/><rdfs:label>cardiac disease</rdfs:label></owl:Class>
  <owl:Class rdf:about="#LungDisease"><rdfs:subClassOf rdf:resource="#Disease"/><rdfs:label>lung disease</rdfs:label></owl:Class>
  <owl:Class rdf:about="#KidneyDisease"><rdfs:subClassOf rdf:resource="#Disease"/><rdfs:label>kidney disease</rdfs:label></owl:Class>
  <owl:Class rdf:about="#Symptom"><rdfs:subClassOf rdf:resource="#Entity"/><rdfs:label>symptom</rdfs:label></owl:Class>
  <owl:Class rdf:about="#Pain"><rdfs:subClassOf rdf:resource="#Symptom"/><rdfs:label>pain</rdfs:label></owl:Class>
  <owl:Class rdf:about="#ChestPain">
    <rdfs:subClassOf rdf:resource="#Pain"/>
    <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/><owl:someValuesFrom rdf:resource="#Heart"/></owl:Restriction></rdfs:subClassOf>
    <rdfs:label>chest pain</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#Treatment"><rdfs:subClassOf rdf:resource="#Entity"/><rdfs:label>treatment</rdfs:label></owl:Class>
  <owl:Class rdf:about="#Drug"><rdfs:subClassOf rdf:resource="#Treatment"/><rdfs:label>drug</rdfs:label></owl:Class>
  <owl:Class rdf:about="#Procedure"><rdfs:subClassOf rdf:resource="#Treatment"/><rdfs:label>procedure</rdfs:label></owl:Class>
  <owl:Class rdf:about="#Person"><rdfs:subClassOf rdf:resource="#Organism"/><rdfs:label>person</rdfs:label></owl:Class>
  <owl:Class rdf:about="#Patient"><rdfs:subClassOf rdf:resource="#Person"/><rdfs:label>patient</rdfs:label></owl:Class>
  <owl:Class rdf:about="#Clinician"><rdfs:subClassOf rdf:resource="#Person"/><owl:equivalentClass rdf:resource="#HealthcareProfessional"/><rdfs:label>clinician</rdfs:label></owl:Class>
  <owl:Class rdf:about="#HealthcareProfessional"><owl:equivalentClass rdf:resource="#Clinician"/><rdfs:label>healthcare professional</rdfs:label></owl:Class>
  <owl:Class rdf:about="#Study"><rdfs:subClassOf rdf:resource="#Entity"/><rdfs:label>study</rdfs:label></owl:Class>
  <owl:Class rdf:about="#CardiacStructure">
    <rdfs:label>cardiac structure</rdfs:label>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="#Structure"/>
          <owl:Restriction><owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/><owl:someValuesFrom rdf:resource="#Heart"/></owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="#DeprecatedConcept"><rdfs:label>deprecated concept</rdfs:label><owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated></owl:Class>
  <owl:Class rdf:about="#IgnoredConcept"><rdfs:label>ignored concept</rdfs:label><align:use_in_alignment rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</align:use_in_alignment></owl:Class>
  <owl:Class rdf:about="#UnlabelledClass"><rdfs:subClassOf rdf:resource="#Entity"/></owl:Class>

  <owl:NamedIndividual rdf:about="#alice"><rdf:type rdf:resource="#Patient"/><ex:participatesIn rdf:resource="#trial1"/><ex:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P-001</ex:hasCode></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#aspirin"><rdf:type rdf:resource="#Drug"/><ex:relatedTo rdf:resource="#alice"/><ex:hasCode>RX-1</ex:hasCode></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#trial1"><rdf:type rdf:resource="#Study"/><rdfs:label>trial one</rdfs:label></owl:NamedIndividual>
</rdf:RDF>
